<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plaud2KeepIt server as a macOS LaunchAgent: starts at login, restarts if it
     stops, and (node --watch) reloads when the code changes.
     service/install.sh fills in the __PLACEHOLDERS__ and installs it into
     ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.plaud2keepit.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--watch</string>
    <string>server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_DIR__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Wait at least 10s between restarts if it keeps failing. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__DIR__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/logs/server.log</string>
</dict>
</plist>
